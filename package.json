{
  "name": "g-scores",
  "version": "1.0.0",
  "private": true,
  "description": "G-Scores is a MERN application for THPT 2024 score lookup and reporting.",
  "scripts": {
    "dev": "node -e \"console.log('Run in two terminals:\\n1) cd backend && npm run dev\\n2) cd frontend && npm run dev')\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "seed": "npm run seed --prefix backend -- --reset",
    "build": "npm run build --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LewingKai/LeMinhKhoi-webdev-intern-assignment.git"
  },
  "keywords": [
    "mern",
    "mongodb",
    "express",
    "react",
    "vite",
    "tailwind",
    "education",
    "exam-score"
  ],
  "author": "Le Minh Khoi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LewingKai/LeMinhKhoi-webdev-intern-assignment/issues"
  },
